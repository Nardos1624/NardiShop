# Use credentials for your local PostgreSQL instance.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=replace_with_your_postgres_password
DB_NAME=NardiShop

# Alternatively, set DATABASE_URL to your hosted PostgreSQL connection string.
# DATABASE_URL=postgres://user:password@host:5432/database

# Telegram bot that receives customers' payment screenshots.
# Get the token from @BotFather; get the chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id
