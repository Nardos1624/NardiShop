# Hosted PostgreSQL (Neon) connection string. Copy it from the Neon dashboard → Connect.
DATABASE_URL=postgres://user:password@host/database?sslmode=require

# Or, for a local PostgreSQL instance, leave DATABASE_URL out and use these instead.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=replace_with_your_postgres_password
# DB_NAME=NardiShop

# Secret used to sign login tokens. Use a long random string and keep it private.
JWT_SECRET=replace_with_a_long_random_string

# Telegram bot that receives new orders.
# Get the token from @BotFather; get the chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id
